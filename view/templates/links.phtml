<?php
/** @var $this \Slim\Views\PhpRenderer */
/** @var $links string[] */
/** @var $actions string[] */
/** @var $parent ?string */

include 'head.phtml';
?>
<div class="page-header">
    <h1>Happy Horizon Composer Patches</h1>
    <p>Browse available platforms, versions and patch files.</p>
</div>

<?php if (isset($parent)): ?>
    <a class="back-link" href="<?= htmlspecialchars($parent, ENT_QUOTES, 'UTF-8') ?>">← Go back</a>
<?php endif; ?>

<div class="panel">
    <?php if (empty($links)): ?>
        <p class="empty-state">No patches yet</p>
    <?php else: ?>
        <ul class="link-list">
            <?php foreach ($links as $link => $title): ?>
                <li>
                    <a href="<?= htmlspecialchars($link, ENT_QUOTES, 'UTF-8') ?>">
                        <span><?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?></span>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
</div>

<?php if (!empty($actions)): ?>
    <div class="actions">
        <?php foreach ($actions as $link => $title): ?>
            <a class="btn" href="<?= htmlspecialchars($link, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?></a>
        <?php endforeach; ?>
    </div>
<?php endif; ?>

<?php include 'foot.phtml'; ?>
