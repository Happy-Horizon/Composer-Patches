<?php
/** @var $this \Slim\Views\PhpRenderer */
/** @var $content string */
/** @var $actions string[]|null */
/** @var $parent ?string */

include 'head.phtml';
?>
<?php if (isset($parent)): ?>
    <a class="back-link" href="<?= htmlspecialchars($parent, ENT_QUOTES, 'UTF-8') ?>">← Go back</a>
<?php endif; ?>

<article class="panel prose">
    <?= $content ?>
</article>

<?php if (!empty($actions)): ?>
    <div class="actions">
        <?php foreach ($actions as $link => $actionTitle): ?>
            <a class="btn" href="<?= htmlspecialchars($link, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars($actionTitle, ENT_QUOTES, 'UTF-8') ?></a>
        <?php endforeach; ?>
    </div>
<?php endif; ?>

<?php include 'foot.phtml'; ?>
