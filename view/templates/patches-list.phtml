<?php
/** @var $this \Slim\Views\PhpRenderer */
/** @var $patches list<array{path: string, filename: string, package: string}> */
/** @var $module string */
/** @var $q string */
/** @var $actions string[] */
/** @var $parent ?string */

include 'head.phtml';
?>
<div class="page-header">
    <h1>All patches</h1>
    <p>Search patches by module / package.</p>
</div>

<?php if (isset($parent)): ?>
    <a class="back-link" href="<?= htmlspecialchars($parent, ENT_QUOTES, 'UTF-8') ?>">← Go back</a>
<?php endif; ?>

<div class="panel">
    <form class="search-form" method="get" action="/patches/all">
        <label>
            Package
            <input type="search" name="q" value="<?= htmlspecialchars($q ?? '', ENT_QUOTES, 'UTF-8') ?>" placeholder="e.g. catalog" />
        </label>
        <?php if (!empty($module)): ?>
            <input type="hidden" name="module" value="<?= htmlspecialchars($module, ENT_QUOTES, 'UTF-8') ?>" />
            <span class="filter-chip">
                Filtered to
                <code><?= htmlspecialchars($module, ENT_QUOTES, 'UTF-8') ?></code>
                <a href="/patches/all<?= $q !== '' ? ('?q=' . urlencode($q)) : '' ?>">clear</a>
            </span>
        <?php endif; ?>
        <div class="search-form__actions">
            <button class="btn" type="submit">Search</button>
            <a class="btn btn--ghost" href="/patches/all">Reset</a>
            <a class="btn btn--ghost" href="/patches/modules">All modules</a>
        </div>
    </form>

    <?php if (empty($patches)): ?>
        <p class="empty-state">No patches found</p>
    <?php else: ?>
        <p class="result-count"><?= count($patches) ?> patch(es)</p>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Package</th>
                        <th>Filename</th>
                        <th>Path</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($patches as $patch): ?>
                        <tr>
                            <td>
                                <a href="/patches/all?module=<?= urlencode($patch['package']) ?>">
                                    <?= htmlspecialchars($patch['package'], ENT_QUOTES, 'UTF-8') ?>
                                </a>
                            </td>
                            <td class="mono"><?= htmlspecialchars($patch['filename'], ENT_QUOTES, 'UTF-8') ?></td>
                            <td>
                                <a class="mono" href="<?= htmlspecialchars($patch['path'], ENT_QUOTES, 'UTF-8') ?>">
                                    <?= htmlspecialchars($patch['path'], ENT_QUOTES, 'UTF-8') ?>
                                </a>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>

<?php if (!empty($actions)): ?>
    <div class="actions">
        <?php foreach ($actions as $link => $title): ?>
            <a class="btn" href="<?= htmlspecialchars($link, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?></a>
        <?php endforeach; ?>
    </div>
<?php endif; ?>

<?php include 'foot.phtml'; ?>
