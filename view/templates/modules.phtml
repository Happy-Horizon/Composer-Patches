<?php
/** @var $this \Slim\Views\PhpRenderer */
/** @var $packages array<string, int> */
/** @var $actions string[] */
/** @var $parent ?string */

include 'head.phtml';
?>
<div class="page-header">
    <h1>Modules</h1>
    <p>Browse patches by module / package.</p>
</div>

<?php if (isset($parent)): ?>
    <a class="back-link" href="<?= htmlspecialchars($parent, ENT_QUOTES, 'UTF-8') ?>">← Go back</a>
<?php endif; ?>

<div class="panel">
    <?php if (empty($packages)): ?>
        <p class="empty-state">No packages found</p>
    <?php else: ?>
        <ul class="link-list">
            <?php foreach ($packages as $package => $count): ?>
                <li>
                    <a href="/patches/all?module=<?= urlencode($package) ?>">
                        <span><?= htmlspecialchars($package, ENT_QUOTES, 'UTF-8') ?></span>
                        <span class="link-list__meta"><?= (int)$count ?> patch<?= (int)$count === 1 ? '' : 'es' ?></span>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
</div>

<?php if (!empty($actions)): ?>
    <div class="actions">
        <?php foreach ($actions as $link => $title): ?>
            <a class="btn" href="<?= htmlspecialchars($link, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?></a>
        <?php endforeach; ?>
    </div>
<?php endif; ?>

<?php include 'foot.phtml'; ?>
