diff --git a/vendor/magento/framework/Filter/Template/DeferredDirectiveRegistry.php b/vendor/magento/framework/Filter/Template/DeferredDirectiveRegistry.php
new file mode 100644
index 0000000000000..c80b0e1848c51
--- /dev/null
