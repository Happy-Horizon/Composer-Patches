+    /**
+     * Resolve an absolute filesystem path to a media-relative path when possible.
+     *
+     * @param string $absolutePath
+     * @return string
+     */
+    private function resolveMediaRelativePath(string $absolutePath): string
+    {
+        $absolutePath = str_replace('\\', '/', $absolutePath);
+        try {
+            $relative = $this->getMediaDirectoryRead()->getRelativePath($absolutePath);
+            if ($relative !== null && $relative !== '' && strpos($relative, '..') !== 0) {
+                return ltrim(str_replace('\\', '/', $relative), '/');
+            }
+        } catch (\Exception $e) {
+            // Fall through to URL/media path heuristics.
+        }
+
+        $mediaMarker = '/media/';
+        $markerPos = strpos($absolutePath, $mediaMarker);
+        if ($markerPos !== false) {
+            return ltrim(substr($absolutePath, $markerPos + strlen($mediaMarker)), '/');
+        }
+
+        return ltrim($absolutePath, '/');
+    }
