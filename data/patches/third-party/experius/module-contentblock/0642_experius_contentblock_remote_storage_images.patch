+    /**
+     * Resolve image size for a media-relative path in a remote-storage-safe way.
+     *
+     * Prefer local getimagesize when the absolute path is a real local file (local media,
+     * DB media storage sync, or Hypernode local cache). Otherwise read via the MEDIA
+     * filesystem driver and use getimagesizefromstring — same outcome as Magento
+     * RemoteStorage Plugin\Image TMP sync without requiring GD open().
+     *
+     * @param string $relativePath Path relative to the media directory
+     * @return array|false Same return shape as getimagesize() / getimagesizefromstring()
+     */
+    private function getImageSizeInfo(string $relativePath)
+    {
+        if ($relativePath === '' || !$this->_mediaDirectory->isFile($relativePath)) {
+            return false;
+        }
+
+        $absolutePath = $this->_mediaDirectory->getAbsolutePath($relativePath);
+        // Capability probe: remote drivers return an absolute-looking path that is not a local file.
+        // phpcs:ignore Magento2.Functions.DiscouragedFunction
+        if (is_file($absolutePath)) {
+            // phpcs:ignore Magento2.Functions.DiscouragedFunction
+            return getimagesize($absolutePath);
+        }
+
+        try {
+            $content = $this->_mediaDirectory->readFile($relativePath);
+        } catch (FileSystemException $e) {
+            return false;
+        }
+
+        if ($content === '' || $content === false) {
+            return false;
+        }
+
+        // phpcs:ignore Magento2.Functions.DiscouragedFunction
+        return getimagesizefromstring($content);
+    }
